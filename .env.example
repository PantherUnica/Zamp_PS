# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI: used server-side to classify and extract fields from uploaded documents.
OPENAI_API_KEY=sk-...
# Optional. Any OpenAI model that accepts PDF/image input and structured outputs.
OPENAI_MODEL=gpt-5.4-mini

# Optional. Comma-separated emails allowed to sign in as reviewers. Empty = any Supabase Auth user.
REVIEWER_EMAILS=

# Only needed to run `npm run db:migrate` (not used by the deployed app).
# Supabase → Project Settings → Database → Connection string (URI, session pooler).
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
